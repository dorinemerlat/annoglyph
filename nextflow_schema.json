{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/dorinemerlat/annoglyph/main/nextflow_schema.json",
    "title": "AnnoGlyph pipeline parameters",
    "description": "Genome annotation pipeline for non-model eukaryotic species.",
    "type": "object",
    "definitions": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "description": "Define the pipeline input and output locations.",
            "required": [
                "input"
            ],
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "schema": "assets/schema_input.json",
                    "description": "Path to the input samplesheet in CSV format."
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Directory where pipeline results are written.",
                    "default": "results"
                },
                "publish_dir_mode": {
                    "type": "string",
                    "enum": [
                        "symlink",
                        "rellink",
                        "link",
                        "copy",
                        "copyNoFollow",
                        "move"
                    ],
                    "description": "Method used to publish pipeline results.",
                    "default": "copy",
                    "hidden": true
                },
                "cacheDir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Directory where persistent process outputs are cached.",
                    "default": "cache"
                },
                "run_group": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
                    "description": "Identifier shared by a run and its resumes; prefixes trace/report filenames to group execution statistics."
                },
                "legacy_cache_manifest": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "file-path",
                    "exists": true,
                    "default": null,
                    "description": "Validated historical cache import manifest. Reuses repeat annotations and available raw gene predictions; missing gene predictions and derived analyses are computed normally."
                }
            }
        },
        "module_options": {
            "title": "Annotation modules",
            "type": "object",
            "description": "Select the annotation modules to run.",
            "properties": {
                "module_repeats": {
                    "type": "boolean",
                    "description": "Run repeat annotation.",
                    "default": true
                },
                "module_genes": {
                    "type": "boolean",
                    "description": "Run protein-coding gene annotation.",
                    "default": true
                },
                "module_ncgenes": {
                    "type": "boolean",
                    "description": "Run non-coding gene annotation.",
                    "default": true
                },
                "comparative_genomics": {
                    "type": "boolean",
                    "description": "Run comparative genomics analyses for enabled modules.",
                    "default": true
                }
            },
            "anyOf": [
                {
                    "properties": {
                        "module_repeats": {
                            "const": true
                        }
                    }
                },
                {
                    "properties": {
                        "module_genes": {
                            "const": true
                        }
                    }
                },
                {
                    "properties": {
                        "module_ncgenes": {
                            "const": true
                        }
                    }
                }
            ]
        },
        "shared_annotation_options": {
            "title": "Shared annotation options",
            "type": "object",
            "properties": {
                "busco_lineage": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "BUSCO lineage used for assessment and gene annotation. When null, AnnoGlyph selects a lineage from the input taxonomy.",
                    "default": null
                }
            }
        },
        "repeat_annotation_options": {
            "title": "Repeat annotation options",
            "type": "object",
            "properties": {
                "reference_library": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "file-path",
                    "exists": true,
                    "description": "Optional reference repeat library in FASTA format.",
                    "default": null
                },
                "repeat_classification_table": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Repeat classification table used to standardize and post-process repeat family annotations.",
                    "default": "data/repeats_classification.csv"
                },
                "group_consensus_sequences": {
                    "type": "boolean",
                    "description": "Build and use a shared consensus repeat library across input genomes.",
                    "default": true
                }
            }
        },
        "gene_annotation_options": {
            "title": "Protein-coding gene annotation options",
            "type": "object",
            "properties": {
                "protein_set": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "file-path",
                    "exists": true,
                    "description": "Protein evidence set used for gene prediction. When null, AnnoGlyph automatically retrieves OrthoDB and UniProtKB protein evidence.",
                    "default": null
                },
                "protein_evidence_min_sequences": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Minimum number of UniProtKB proteins required for automatic taxonomic clade selection. AnnoGlyph starts from the most specific taxon shared by all input species and moves toward broader ancestral taxa until this threshold is reached.",
                    "default": 100000
                },
                "protein_evidence_max_sequences": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1,
                    "description": "Maximum total number of protein sequences retained in the automatically generated evidence set. Sequences are split approximately equally between OrthoDB and UniProtKB. When null, all downloaded sequences are retained.",
                    "default": null,
                    "hidden": true
                },
                "blast_db": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "BLAST protein database prefix used for functional annotation.",
                    "default": "/shared/bank/uniprot_swissprot/uniprot_swissprot_2025_01/blast/uniprot_sprot"
                },
                "omark_contamination_threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "OMArk contamination filtering threshold.",
                    "default": 0.1
                },
                "rna_seq_aligner": {
                    "type": "string",
                    "enum": [
                        "star",
                        "varus",
                        "both"
                    ],
                    "description": "RNA-seq alignment strategy used for gene annotation.",
                    "default": "both"
                },
                "sra_run_limit": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1,
                    "description": "Maximum number of SRA runs selected for download and STAR alignment. When null, all eligible runs are retained.",
                    "default": null
                },
                "sra_run_max_bases": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1,
                    "description": "Maximum number of bases allowed per SRA run selected for download and STAR alignment. When null, no per-run size limit is applied.",
                    "default": null
                },
                "tool_only_protein_evidence": {
                    "type": "string",
                    "enum": [
                        "galba",
                        "braker2",
                        "both"
                    ],
                    "description": "Gene prediction tool used when only protein evidence is available.",
                    "default": "both"
                },
                "interproscan_db": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "directory-path",
                    "exists": true,
                    "description": "Complete InterProScan 5.59-91.0 data directory. Not needed when using the complete IFB image.",
                    "default": null
                },
                "signalp": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run the optional SignalP analysis."
                },
                "toxprot_blast": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run the optional ToxProt BLAST analysis."
                },
                "selection_thresholds": {
                    "type": "object",
                    "default": {},
                    "additionalProperties": false,
                    "properties": {
                        "expected_gene_number": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "minimum": 0,
                            "default": 15000,
                            "description": "Expected genes per genome; null disables gene-count scoring and its tie-break."
                        },
                        "gene_number_good_deviation": {
                            "type": "number",
                            "minimum": 0,
                            "default": 5000
                        },
                        "gene_number_neutral_deviation": {
                            "type": "number",
                            "minimum": 0,
                            "default": 10000
                        },
                        "protein_length_q1_min": {
                            "type": "number",
                            "minimum": 0,
                            "default": 120
                        },
                        "busco_complete_min": {
                            "type": "number",
                            "minimum": 0,
                            "default": 70,
                            "maximum": 100
                        },
                        "busco_duplicated_max": {
                            "type": "number",
                            "minimum": 0,
                            "default": 3,
                            "maximum": 100
                        },
                        "omark_consistent_min": {
                            "type": "number",
                            "minimum": 0,
                            "default": 60,
                            "maximum": 100
                        },
                        "omark_contamination_max": {
                            "type": "number",
                            "minimum": 0,
                            "default": 0,
                            "maximum": 100
                        },
                        "omark_unknown_max": {
                            "type": "number",
                            "minimum": 0,
                            "default": 30,
                            "maximum": 100
                        },
                        "start_codon_min": {
                            "type": "number",
                            "minimum": 0,
                            "default": 80,
                            "maximum": 100
                        },
                        "orthoinspector_protein_length_q1_min": {
                            "type": "number",
                            "minimum": 0,
                            "default": 115
                        },
                        "orthoinspector_busco_complete_min": {
                            "type": "number",
                            "minimum": 0,
                            "default": 70,
                            "maximum": 100
                        },
                        "orthofinder_protein_length_q1_min": {
                            "type": "number",
                            "minimum": 0,
                            "default": 150
                        },
                        "orthofinder_busco_complete_min": {
                            "type": "number",
                            "minimum": 0,
                            "default": 80,
                            "maximum": 100
                        },
                        "orthofinder_gene_number_min": {
                            "type": "number",
                            "minimum": 0,
                            "default": 10000
                        },
                        "orthofinder_contamination_max": {
                            "type": "number",
                            "minimum": 0,
                            "default": 0,
                            "maximum": 100
                        },
                        "orthofinder_start_codon_min": {
                            "type": "number",
                            "minimum": 0,
                            "default": 40,
                            "maximum": 100
                        }
                    },
                    "description": "Overrides for automatic annotation selection and downstream quality flags."
                },
                "evaluation_mode": {
                    "type": "boolean",
                    "default": false,
                    "description": "Exclude the target genus from automatically downloaded protein evidence. User-supplied protein_set files are used unchanged. Unresolved protein taxonomy is excluded."
                },
                "protein_evidence_taxonomy_db": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "file-path",
                    "exists": true,
                    "default": null,
                    "description": "ETE NCBI taxonomy SQLite database for evaluation filtering; null reuses omark_taxonomy_db."
                }
            }
        },
        "export_options": {
            "title": "Non-coding RNA and final export",
            "type": "object",
            "properties": {
                "rfam_db": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "directory-path",
                    "exists": true,
                    "default": null,
                    "description": "Indexed Rfam folder containing Rfam.cm, four cmpress indexes, Rfam.clanin and family.txt."
                },
                "rfam_release": {
                    "type": "string",
                    "pattern": "^(CURRENT|[0-9]+\\.[0-9]+)$",
                    "default": "15.0",
                    "description": "Rfam release to download when rfam_db is unset."
                },
                "omamer_db": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "file-path",
                    "exists": true,
                    "default": null,
                    "description": "OMA LUCA HDF5 database compatible with the configured OMAmer version."
                },
                "locus_tag_prefix": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                    "default": null,
                    "description": "Registered locus tag prefix for export; defaults to the sample mnemonic for local use."
                },
                "translation_table": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1,
                    "description": "Default genetic code for final CDS translation; feature transl_table overrides this value."
                },
                "ncrna_stats_group_rank": {
                    "type": "string",
                    "default": "family",
                    "description": "Taxonomy TSV column used to group genomes in ncRNA correlation plots."
                },
                "ncrna_stats_min_group_size": {
                    "type": "integer",
                    "minimum": 3,
                    "default": 3,
                    "description": "Minimum genomes for descriptive ncRNA correlations and additional tree clades."
                },
                "submission_metadata": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null,
                    "format": "file-path",
                    "exists": true,
                    "description": "JSON metadata indexed by genome ID."
                },
                "submission_template": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null,
                    "format": "file-path",
                    "exists": true,
                    "description": "NCBI submission template in SBT format."
                },
                "table2asn_binary": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null,
                    "format": "file-path",
                    "exists": true,
                    "description": "Linux table2asn executable."
                },
                "database_lock_file": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null,
                    "format": "file-path",
                    "exists": true,
                    "description": "Previously exported database lock manifest to check."
                },
                "validate_submission": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run local NCBI table2asn validation; never uploads data."
                },
                "table2asn_sha256": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null,
                    "pattern": "^[A-Fa-f0-9]{64}$",
                    "description": "Expected SHA-256 of the supplied validator executable."
                },
                "submission_fail_on_errors": {
                    "type": "boolean",
                    "default": true,
                    "description": "Fail the export if official local validation does not pass."
                },
                "eggnog_db": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "directory-path",
                    "default": "/shared/bank/emapperdb/5.0.2/",
                    "description": "Versioned eggNOG database directory."
                },
                "omamer_download_url": {
                    "type": "string",
                    "default": "https://zenodo.org/records/10403053/files/LUCA-v2.0.0.h5?download=1",
                    "description": "Archived OMA database URL."
                },
                "omamer_download_md5": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{32}$",
                    "default": "c7b5969ed5577750c83973cb46bb0f2d",
                    "description": "Expected checksum of the archived OMA database."
                },
                "provenance_hash_databases": {
                    "type": "boolean",
                    "default": false,
                    "description": "Hash all database files; otherwise inventory large files and hash small release metadata. Protein evidence is always fully hashed."
                },
                "uniprot_evidence_release": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null,
                    "pattern": "^[0-9]{4}_[0-9]{2}$",
                    "description": "Expected release of automatic UniProt REST evidence; mismatch stops the download."
                },
                "gene_min_length": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 90,
                    "description": "Existing AGAT gene-length filter threshold in nucleotides."
                },
                "program_args": {
                    "type": "object",
                    "default": {},
                    "additionalProperties": false,
                    "properties": {
                        "busco": {
                            "type": "string",
                            "description": "Additional CLI options; required input/output flags remain controlled by AnnoGlyph."
                        },
                        "repeatmodeler": {
                            "type": "string",
                            "description": "Additional CLI options; required input/output flags remain controlled by AnnoGlyph."
                        },
                        "repeatmasker": {
                            "type": "string",
                            "description": "Additional CLI options; required input/output flags remain controlled by AnnoGlyph."
                        },
                        "cdhit": {
                            "type": "string",
                            "description": "Additional CLI options; required input/output flags remain controlled by AnnoGlyph."
                        },
                        "braker2": {
                            "type": "string",
