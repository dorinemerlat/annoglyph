                        },
                        "seqkit": {
                            "type": "string",
                            "description": "Additional CLI options; required input/output flags remain controlled by AnnoGlyph."
                        },
                        "agat_longest": {
                            "type": "string",
                            "description": "Extra AGAT arguments; required file/output options stay controlled by the workflow."
                        },
                        "agat_extract": {
                            "type": "string",
                            "description": "Extra AGAT arguments; required file/output options stay controlled by the workflow."
                        }
                    }
                },
                "program_resources": {
                    "type": "object",
                    "default": {},
                    "additionalProperties": false,
                    "properties": {
                        "busco": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpus": {
                                    "type": "integer",
                                    "minimum": 1
                                },
                                "memory": {
                                    "type": "string",
                                    "description": "Nextflow memory, for example 64 GB."
                                },
                                "time": {
                                    "type": "string",
                                    "description": "Nextflow duration, for example 2d."
                                }
                            }
                        },
