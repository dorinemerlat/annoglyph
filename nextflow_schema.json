                        },
                        "galba": {
                            "type": "string",
                            "description": "Additional CLI options; required input/output flags remain controlled by AnnoGlyph."
                        },
                        "star": {
                            "type": "string",
                            "description": "Additional CLI options; required input/output flags remain controlled by AnnoGlyph."
                        },
                        "star_index": {
                            "type": "string",
                            "description": "Additional CLI options; required input/output flags remain controlled by AnnoGlyph."
                        },
                        "varus": {
                            "type": "string",
                            "description": "Additional CLI options; required input/output flags remain controlled by AnnoGlyph."
                        },
                        "blastp": {
                            "type": "string",
                            "description": "Additional CLI options; required input/output flags remain controlled by AnnoGlyph."
                        },
                        "interproscan": {
                            "type": "string",
                            "description": "Additional CLI options; required input/output flags remain controlled by AnnoGlyph."
                        },
                        "eggnog": {
                            "type": "string",
                            "description": "Additional CLI options; required input/output flags remain controlled by AnnoGlyph."
                        },
                        "trnascan": {
                            "type": "string",
                            "description": "Additional CLI options; required input/output flags remain controlled by AnnoGlyph."
                        },
                        "barrnap": {
                            "type": "string",
