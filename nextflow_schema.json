{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/exogap/master/nextflow_schema.json",
    "title": "EXOGAP pipeline parameters",
    "description": "Genome annotation pipeline for non-model eukaryotic species.",
    "type": "object",
    "definitions": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "description": "Define the pipeline input and output locations.",
            "required": [
                "input"
            ],
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "schema": "assets/schema_input.json",
                    "description": "Path to the input samplesheet in CSV format."
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Directory where pipeline results are written.",
                    "default": "results"
                },
                "publish_dir_mode": {
                    "type": "string",
                    "enum": [
                        "symlink",
                        "rellink",
                        "link",
                        "copy",
                        "copyNoFollow",
                        "move"
                    ],
                    "description": "Method used to publish pipeline results.",
                    "default": "copy",
                    "hidden": true
                }
            }
        },
        "module_options": {
            "title": "Annotation modules",
            "type": "object",
            "description": "Select the annotation modules to run.",
            "properties": {
                "module_repeats": {
                    "type": "boolean",
                    "description": "Run repeat annotation.",
                    "default": true
                },
                "module_genes": {
                    "type": "boolean",
                    "description": "Run protein-coding gene annotation.",
                    "default": true
                },
                "module_ncgenes": {
                    "type": "boolean",
                    "description": "Run non-coding gene annotation.",
                    "default": true
                },
                "comparative_genomics": {
                    "type": "boolean",
                    "description": "Run comparative genomics analyses for enabled modules.",
                    "default": true
                }
            },
            "anyOf": [
                {
                    "properties": {
                        "module_repeats": {
                            "const": true
                        }
                    }
                },
                {
                    "properties": {
                        "module_genes": {
                            "const": true
                        }
                    }
                },
                {
                    "properties": {
                        "module_ncgenes": {
                            "const": true
                        }
                    }
                }
            ]
        },
        "shared_annotation_options": {
            "title": "Shared annotation options",
            "type": "object",
            "properties": {
                "busco_lineage": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "BUSCO lineage used for assessment and gene annotation. When null, EXOGAP selects a lineage from the input taxonomy.",
                    "default": null
                }
            }
        },
        "repeat_annotation_options": {
            "title": "Repeat annotation options",
            "type": "object",
            "properties": {
                "reference_library": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "file-path",
                    "exists": true,
                    "description": "Optional reference repeat library in FASTA format.",
                    "default": null
                },
                "repeat_classification_table": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Repeat classification table used to standardize and post-process repeat family annotations.",
                    "default": "data/repeats_classification.csv"
                },
                "group_consensus_sequences": {
                    "type": "boolean",
                    "description": "Build and use a shared consensus repeat library across input genomes.",
                    "default": true
                }
            }
        },
        "gene_annotation_options": {
            "title": "Protein-coding gene annotation options",
            "type": "object",
            "properties": {
                "protein_set": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "file-path",
                    "exists": true,
                    "description": "Protein evidence set used for gene prediction.",
                    "default": null
                },
                "blast_db": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "BLAST protein database prefix used for functional annotation.",
                    "default": null
                },
                "omark_contamination_threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "OMArk contamination filtering threshold.",
                    "default": 0.1
                },
                "rna_seq_aligner": {
                    "type": "string",
                    "enum": [
                        "star",
                        "varus",
                        "both"
                    ],
                    "description": "RNA-seq alignment strategy used for gene annotation.",
                    "default": "both"
                },
                "sra_run_limit": { 
                    "type": [ 
                        "integer", 
                        "null" 
                    ], 
                    "minimum": 1, 
                    "description": "Maximum number of SRA runs selected for download and STAR alignment. When null, all eligible runs are retained.", 
                    "default": null 
                }, 
                "sra_run_max_bases": {
                     "type": [ 
                        "integer", 
                        "null" 
                    ], 
                    "minimum": 1, 
                    "description": "Maximum number of bases allowed per SRA run selected for download and STAR alignment. When null, no per-run size limit is applied.", 
                    "default": null 
                },
                "tool_only_protein_evidence": {
                    "type": "string",
                    "enum": [
                        "galba",
                        "braker2",
                        "both"
                    ],
                    "description": "Gene prediction tool used when only protein evidence is available.",
                    "default": "both"
                },
                "protein_evidence_max_sequences": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1,
                    "description": "Maximum number of protein sequences retained from each evidence source. Intended mainly for testing. When null, all sequences are retained.",
                    "default": null,
                    "hidden": true
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/definitions/input_output_options"
        },
        {
            "$ref": "#/definitions/module_options"
        },
        {
            "$ref": "#/definitions/shared_annotation_options"
        },
        {
            "if": {
                "properties": {
                    "module_repeats": {
                        "const": true
                    }
                },
                "required": [
                    "module_repeats"
                ]
            },
            "then": {
                "$ref": "#/definitions/repeat_annotation_options"
            }
        },
        {
            "if": {
                "properties": {
                    "module_genes": {
                        "const": true
                    }
                },
                "required": [
                    "module_genes"
                ]
            },
            "then": {
                "$ref": "#/definitions/gene_annotation_options"
            }
        }
    ]
}
