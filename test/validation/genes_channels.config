params.cacheDir = "${projectDir}/test/validation/cache_genes_both"
params.protein_set = "${projectDir}/test/validation/genes_proteins.fasta"
process {
    executor = 'local'
    scratch = false
    withName: '.*' {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }
    withName: SAMTOOLS_READ_COUNT {
        ext.stub_read_count = { params.test_read_count }
    }
}
params.sra_run_limit = 3
params.sra_run_max_bases = 1000000000

params.test_read_count = 2000001
