params.cacheDir = "${projectDir}/test/validation/cache_genes_functional_real"
process {
    executor = 'local'
    scratch = false
}
env.BLASTDB = '/shared/bank/uniprot_swissprot/current/blast'
process {
    withName: EGGNOGMAPPER {
        // Keep this local validation run outside the login node's cleaned /tmp.
        ext.args = "--report_orthologs --scratch_dir ${projectDir}/.apptainer_tmp/genes-functional --temp_dir ${projectDir}/.apptainer_tmp/genes-functional"
    }
}

process {
    withName: INTERPROSCAN {
        container = '/shared/software/singularity/images/interproscan-5.59-91.0.sif'
        ext.use_container_data = true
        // Match the analyses enabled by the original BioContainers image.
        ext.args = '-f TSV -dp -goterms -iprlookup -pa -t p -appl AntiFam,CDD,Coils,FunFam,Gene3D,Hamap,MobiDBLite,PANTHER,Pfam,PIRSF,PIRSR,PRINTS,ProSitePatterns,ProSiteProfiles,SFLD,SMART,SUPERFAMILY,TIGRFAM'
    }
}
