params.rna_seq_aligner = 'star'
params.legacy_cache_manifest = null
params.rnaseq_min_mapped_reads = 0
params.test_read_count = 100
params.test_clean_read_count = 100
params.test_local_libraries = true
params.cacheDir = "${launchDir}/cache"
params.outdir = "${launchDir}/results"
process {
    executor = 'local'
    scratch = false
    withName: '.*' {
        cpus = 1
        memory = 1.GB
        time = 1.h
    }
    withName: SAMTOOLS_READ_COUNT {
        ext.stub_read_count = { params.test_read_count }
    }
    withName: CLEAN_RNASEQ_READS {
        ext.stub_read_count = { params.test_clean_read_count }
    }
}
