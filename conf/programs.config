// Keep resource overrides separate from the default scientific configuration.

if (params.program_resources.busco) {
    process {
        withName: 'AnnoGlyph:.*:(BUSCO_BUSCO|BUSCO_PROTEINS|BUSCO_PROTEINS_AFTER)' {
            if (params.program_resources.busco.cpus != null) {
                cpus = params.program_resources.busco.cpus
            }
            if (params.program_resources.busco.memory != null) {
                memory = params.program_resources.busco.memory
            }
            if (params.program_resources.busco.time != null) {
                time = params.program_resources.busco.time
            }
        }
    }
}

