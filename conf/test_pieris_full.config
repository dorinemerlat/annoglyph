// Full evidence integration test: all usable downloaded proteins and eligible SRA runs.
params {
    input = "${projectDir}/test/samplesheet_pieris.csv"
    outdir = "${projectDir}/test/test_pieris/full/results"
    cacheDir = "${projectDir}/test/test_pieris/full/cache"

    module_repeats = true
    module_genes = true
    module_ncgenes = true
    comparative_genomics = true
    busco_lineage = null
    reference_library = null
    group_consensus_sequences = true

    protein_set = "${projectDir}/test/test_pieris/protein_evidence_full.fasta"
    protein_evidence_min_sequences = 1
    protein_evidence_max_sequences = null
    blast_db = null
    rna_seq_aligner = 'star'
    sra_run_limit = null
    sra_run_max_bases = null
}
