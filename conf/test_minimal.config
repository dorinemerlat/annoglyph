/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    AnnoGlyph minimal test configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    run_group = "test_minimal"
    input  = "${projectDir}/test/samplesheet_minimal.csv"
    outdir = "${projectDir}/test/test_minimal/results"
    cacheDir    = "${projectDir}/test/test_minimal/cache"
    
    module_repeats       = true
    module_genes         = true
    module_ncgenes       = true
    comparative_genomics = true

    busco_lineage = null

    reference_library           = null
    group_consensus_sequences   = false

    protein_set     = null

    rna_seq_aligner = 'star'
    sra_max_spots = 500000
    rnaseq_min_mapped_reads = 100000
    sra_run_limit     = 3
    sra_run_max_bases = 1000000000  // 1 Gbases
}

includeConfig "${projectDir}/conf/test_proteins.config"

// Fully qualified selectors retain the default containers and scientific options.
process {
    withName: 'AnnoGlyph:.*:(REPEATMODELER_REPEATMODELER|REPEATMASKER_REPEATMASKER|MCHELPER|BRAKER2|BRAKER3|GALBA|STAR_GENOMEGENERATE|STAR_SINGLE|STAR_PAIRED)' {
        cpus = 8
        memory = '16 GB'
        time = '4h'
    }
}
