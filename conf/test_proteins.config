// Reviewed, nonredundant yeast homologs for the Saccharomycetales test datasets.
params {
    protein_set = "${projectDir}/test/data/saccharomyces_uniprot_2000.fasta"
    protein_evidence_min_sequences = 2000
    protein_evidence_max_sequences = 2000
}

process {
    // Preserve RNA-seq/repeat caches, and isolate predictions made with this evidence.
    withName: 'EXOGAP:GENES_ANNOTATION:(STRUCTURAL_ANNOTATION|FUNCTIONAL_ANNOTATION):.*' {
        storeDir = {
            def components = task.process.tokenize(':').drop(2)
            def tag = task.tag ?: ''
            ("${params.cacheDir}/genes_annotation/test_proteins_2000/" +
                components.join('/') + (tag ? "/${tag}" : '')).toLowerCase()
        }
    }
}
