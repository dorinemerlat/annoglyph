def runTimestamp = new Date().format('yyyyMMdd-HHmmss')

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_trace_${runTimestamp}.tsv"

    fields = [
        'task_id',
        'hash',
        'native_id',
        'process',
        'name',
        'tag',
        'status',
        'attempt',
        'exit',
        'container',
        'queue',
        'submit',
        'start',
        'complete',
        'duration',
        'realtime',
        'time',
        '%cpu',
        'cpus',
        '%mem',
        'memory',
        'rss',
        'peak_rss',
        'vmem',
        'peak_vmem',
        'read_bytes',
        'write_bytes',
        'cpu_model'
    ]
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_report_${runTimestamp}.html"
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${runTimestamp}.html"
}

dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${runTimestamp}.html"
}