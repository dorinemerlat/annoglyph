def runTimestamp = new Date().format('yyyyMMdd-HHmmss-SSS')
def group = params.run_group?.toString()
if (group && !(group ==~ /[A-Za-z0-9][A-Za-z0-9_.-]*/)) {
    throw new IllegalArgumentException('run_group must start with a letter/digit and contain only letters, digits, _, . or -')
}
def reportSuffix = group ? "${group}_${runTimestamp}" : runTimestamp

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_trace_${reportSuffix}.tsv"

    fields = [
        'task_id',
        'hash',
        'native_id',
        'process',
        'name',
        'tag',
        'status',
        'attempt',
        'exit',
        'container',
        'queue',
        'submit',
        'start',
        'complete',
        'duration',
        'realtime',
        'time',
        '%cpu',
        'cpus',
        '%mem',
        'memory',
        'rss',
        'peak_rss',
        'vmem',
        'peak_vmem',
        'read_bytes',
        'write_bytes',
        'cpu_model'
    ]
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_report_${reportSuffix}.html"
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${reportSuffix}.html"
}

dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${reportSuffix}.html"
}
