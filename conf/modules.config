// Increase memory after an out-of-memory failure.
// When force=true, increase memory after every retry.
def getMemory(baseMemory, task, force=false) {
    if (task.attempt > 1) {
        if (force || task.previousTrace.exit in [137, 140]) {
            return baseMemory * task.attempt
        }
    }

    return baseMemory
}

// Increase walltime linearly after a timeout.
def getTime(baseTime, task) {
    if (task.attempt > 1 && task.previousTrace.exit == 143) {
        return baseTime * task.attempt
    }

    return baseTime
}


// Retry only memory failures and timeouts.
// When force=true, retry regardless of the previous exit status.
def getErrorStrategy(exitStatus, force=false) {
    if (force || exitStatus in [137, 140, 143]) {
        return 'retry'
    }

    return 'finish'
}


// Define default process options for all modules here.
process {
    // General process options

    cpus = 1
    memory = { getMemory(2.GB, task) }
    time = { getTime(4.h, task) }

    maxRetries = 4
    errorStrategy = { getErrorStrategy(task.exitStatus) }

    // Only modules with specific resource requirements are defined here, others will use the default values above
    // Preprocessing module
    withName: GENERATE_TAXONOMY_METADATA {
        maxForks = 10
    }

    withName: REFORMAT_GENOME {
        memory = { getMemory(10.GB, task) }
    }

    withName: DOWNLOAD_BUSCO_DATASET {
        memory = { getMemory(10.GB, task) }
    }

    withName: BUSCO {
        cpus = 10
        memory = { getMemory(10.GB, task, force=true) }
        errorStrategy = { getErrorStrategy(task.exitStatus, force=true) }
    }

    // Repetitive elements prediction module
    withName: REPEATMODELER {
        cpus = 30
        memory = { getMemory(100.GB, task) }
        time = { getTime(20.d, task) }
    }

    withName: HMMSCAN_BUSCO_GENES {
        cpus = 5
        memory = { getMemory(10.GB, task) }
        time = { getTime(2.h, task) }
    }

    withName: HMMSCAN_RRNA {
        cpus = 5
        memory = { getMemory(10.GB, task) }
        time = { getTime(2.h, task) }
    }

    withName: MCHELPER {
        cpus = 20
        memory = { getMemory(50.GB, task) }
        // time = { getTime(20.d, task) }
    }

    withName: CD_HIT_EST {
        cpus = 10
        memory = { getMemory(50.GB, task) }
        time = { getTime(10.h, task) }
    }

    withName: REPEATMASKER {
        cpus = 30
        memory = { getMemory(50.GB, task) }
        //time = { getTime(5.d, task) }
    }

    withName: SUMMARIZE_REPEATS_BY_LEVEL {
        memory = { getMemory(10.GB, task) }
    }

    // Protein-coding gene prediction module

    // Non-coding RNA prediction module

    // Post-processing module
}