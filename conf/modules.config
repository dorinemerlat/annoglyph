// Increase memory after resource failures. STAR reports its required BAM-sort
// bytes in the previous work directory; reserve 25% extra for the whole task.
def getMemory(baseMemory, task, force=false) {
    if (task.attempt > 1) {
        def previous = task.previousTrace
        long previousBytes = previous.memory instanceof Number ? previous.memory.longValue() :
            (previous.memory ? previous.memory.toBytes() : baseMemory.toBytes())
        def previousMemory = new nextflow.util.MemoryUnit(previousBytes)
        if (previous.exit == 102) {
            long required = 0
            def directory = previous.workdir
            if (directory != null) {
                for (name in ['.command.log', '.command.err', '.command.out']) {
                    try {
                        def output = new File(directory.toString(), name)
                        if (output.isFile()) output.eachLine { line ->
                            def match = line =~ /--limitBAMsortRAM\s+(\d+)/
                            if (line.contains('SOLUTION:') && match.find()) {
                                required = Math.max(required, match.group(1).toLong())
                            }
                        }
                    } catch (IOException ignored) {
                        // Fall back to increasing the previous memory request.
                    }
                }
            }
            long lastBytes = previousBytes
            long bytes = Math.max(baseMemory.toBytes(), Math.max(lastBytes * 2L, (long)Math.ceil(required * 1.25d)))
            return new nextflow.util.MemoryUnit("${(long)Math.ceil(bytes / (1024d * 1024 * 1024))} GB")
        }
        if (force || previous.exit in [137, 140]) {
            def increased = baseMemory * task.attempt
            return previousMemory > increased ? previousMemory * 2 : increased
        }
        // A subsequent disk/time retry must not discard an earlier memory increase.
        if (previousMemory > baseMemory) return previousMemory
    }
    return baseMemory
}

// Increase walltime linearly after a timeout.
def getTime(baseTime, task) {
    if (task.attempt > 1 && task.previousTrace.exit == 143) {
        return baseTime * task.attempt
    }

    return baseTime
}


// Retry only recognized resource failures. Keep diagnostic inspection in this
// function: nested config helper calls are not resolved consistently by Nextflow.
// Scratch allocation can fail before .command.err exists, so inspect the wrapper
// log as well. The existing maxRetries still bounds all attempts.
def getErrorStrategy(exitStatus, force=false, workDir=null) {
    if (force || exitStatus in [137, 140, 143]) return 'retry'
    if (exitStatus != 0 && workDir != null) {
        for (name in ['.command.log', '.command.err', '.command.out']) {
            def output = new File(workDir.toString(), name)
            try {
                if (output.isFile() && output.withReader { reader ->
                    String line
                    while ((line = reader.readLine()) != null) {
                        def message = line.toLowerCase(java.util.Locale.ROOT)
                        if (message.contains('no space left on device') || message.contains('disk quota exceeded')) return true
                        // 102 is not a general OOM code: require STAR's diagnostic.
                        if (exitStatus == 102 && (message.contains('not enough memory for bam sorting') ||
                            (message.contains('solution:') && message.contains('--limitbamsortram')))) return true
                    }
                    return false
                }) return 'retry'
            } catch (IOException ignored) {
                // Preserve the original failure if diagnostics are unavailable.
            }
        }
    }
    return 'finish'
}


// Define default process options for all modules here.
process {
    // General process options
    withName: RESOLVE_RFAM_METADATA {
        storeDir = null
    }

    cpus = 1
    memory = { getMemory(2.GB, task) }
    time = { getTime(4.h, task) }

    maxRetries = 4
    errorStrategy = { getErrorStrategy(task.exitStatus, false, task.workDir) }

    // Only modules with specific resource requirements are defined here, others will use the default values above
    // Preprocessing module
    withName: 'AnnoGlyph:PREPROCESSING:SEQKIT_STATS' {
        container = 'quay.io/biocontainers/seqkit:2.8.2--h9ee0642_1'
        ext.args = { '--seq-type dna --all ' + (params.program_args.seqkit ?: '') }
    }

    withName: BUSCO_DOWNLOAD {
        container = 'docker://ezlabgva/busco:v6.0.0_cv1'
        memory = { getMemory(10.GB, task) }
    }

    withName: BUSCO_BUSCO {
        container = 'docker://ezlabgva/busco:v6.0.0_cv1'
        // Parent directories and nested files are both emitted by this module.
        // Copy them to storeDir so staging the parent cannot remove child outputs.
        stageOutMode = 'copy'
        cpus = 10
        memory = { getMemory(10.GB, task, force=true) }
        errorStrategy = { getErrorStrategy(task.exitStatus, true, task.workDir) }
        ext.args = { '--offline --force' + ' ' + (params.program_args.busco ?: '') }
        ext.prefix = { "${meta.id}_on_assembly" }
    }

    withName: GENERATE_TAXONOMY_METADATA {
        maxForks = 10
        // Aggregated metadata must match this samplesheet. Taxon responses are
        // cached individually by the Python helper, including partial runs.
        storeDir = null
    }

    withName: REFORMAT_GENOME {
        memory = { getMemory(10.GB, task) }
    }


    withLabel: 'busco' {
        cpus = 10
        memory = { getMemory(10.GB, task, force=true) }
        errorStrategy = { getErrorStrategy(task.exitStatus, true, task.workDir) }
    }

    // Repetitive elements prediction module
    withName: REPEATMODELER_BUILDDATABASE {
        container = 'quay.io/biocontainers/repeatmodeler:2.0.5--pl5321hdfd78af_0'
        ext.args = '-engine ncbi'
    }

    withName: REPEATMODELER_REPEATMODELER {
        container = 'quay.io/biocontainers/repeatmodeler:2.0.5--pl5321hdfd78af_0'
        cpus = 30
        memory = { getMemory(100.GB, task) }
        time = { getTime(20.d, task) }
        // Keep large LTR intermediates off the compute node's limited /tmp.
        scratch = false
        beforeScript = 'export TMPDIR="$PWD"; export TMP="$PWD"; export TEMP="$PWD"'
        ext.args = { '-engine ncbi -LTRStruct' + ' ' + (params.program_args.repeatmodeler ?: '') }
        ext.prefix = { "${meta.id}" }
    }

    withName: CDHIT_CDHITEST {
        container = 'quay.io/biocontainers/cd-hit:4.8.1--h5ca1c30_13'
        cpus = 10
        memory = { getMemory(50.GB, task) }
        time = { getTime(10.h, task) }
        ext.args = { '-c 0.8 -n 10 -l 80 -aS 0.8 -g 1 -sc 1 -sf 1 -d 0' + ' ' + (params.program_args.cdhit ?: '') }
        ext.memory_limit = 0
        ext.prefix = { "${meta.id}.nr" }
        ext.suffix = 'fa'
    }

    withName: REPEATMASKER_REPEATMASKER {
        container = 'quay.io/biocontainers/repeatmasker:4.2.1--pl5321hdfd78af_0'
        cpus = 30
        memory = { getMemory(50.GB, task) }
        time = { getTime(5.d, task) }
        ext.args = { '-e ncbi -a -gccalc -norna -excln -s -xsmall -gff' + ' ' + (params.program_args.repeatmasker ?: '') }
        ext.prefix = { "genome_${meta.id}.fa" }
    }


    withName: HMMSCAN_BUSCO_GENES {
        cpus = 5
        memory = { getMemory(10.GB, task) }
        time = { getTime(2.h, task) }
    }

    withName: HMMSCAN_RRNA {
        cpus = 5
        memory = { getMemory(10.GB, task) }
        time = { getTime(2.h, task) }
    }

    withName: MCHELPER {
        cpus = 20
        memory = { getMemory(50.GB, task) }
        time = { getTime(20.d, task) }
    }



    withName: SUMMARIZE_REPEATS_BY_LEVEL {
        memory = { getMemory(10.GB, task) }
    }

    // Protein-coding gene prediction module
    withName: GENERATE_RUNLIST {
        maxForks = 1
    }

    withName: SRATOOLS_FASTERQDUMP {
        cpus = 10
        memory = { getMemory(10.GB, task) }
    }

    withName: STAR_SINGLE {
        cpus = 20
        memory = { getMemory((meta.star_memory_gb as int).GB, task) }
        time = { getTime(5.d, task) }
        stageInMode = 'symlink'
        scratch = false
        maxForks = 4
    }

    withName: STAR_PAIRED {
        cpus = 20
        memory = { getMemory((meta.star_memory_gb as int).GB, task) }
        time = { getTime(5.d, task) }
        stageInMode = 'symlink'
        scratch = false
        maxForks = 4
    }


    withName: VARUS {
        cpus = 20
        memory = { getMemory(64.GB, task) }
        time = { getTime(5.d, task) }
        stageInMode = 'copy'
    }

    withName: BRAKER2 {
        cpus = 20
        memory = { getMemory(64.GB, task) }
        time = { getTime(5.d, task) }
        stageInMode = 'copy'
        errorStrategy = { getErrorStrategy(task.exitStatus, true, task.workDir) }
    }

    withName: BRAKER3 {
        cpus = 20
        memory = { getMemory(64.GB, task) }
        time = { getTime(5.d, task) }
        stageInMode = 'copy'
        errorStrategy = { getErrorStrategy(task.exitStatus, true, task.workDir) }
    }

    withName: GALBA {
        cpus = 20
        memory = { getMemory(64.GB, task) }
        time = { getTime(5.d, task) }
        stageInMode = 'copy'
        errorStrategy = { getErrorStrategy(task.exitStatus, true, task.workDir) }
    }

    withName: BLASTP {
        cpus = 10
    }

    withName: INTERPROSCAN {
        cpus = 10
    }


    withName: INTERPROSCAN {
        memory = { getMemory(16.GB, task) }
    }

    // Optional QC modules retain their resources when the subworkflow is enabled.
    withLabel: 'omark_filter' {
        memory = { getMemory(10.GB, task) }
    }

    withName: TOXPROT_BLASTP {
        cpus = 5
        memory = { getMemory(5.GB, task) }
    }

    withName: SIGNALP {
        memory = { getMemory(10.GB, task) }
    }

    // Post-processing module
}

// nf-core replacements in the protein-coding gene subworkflows.
process {
    withName: SAMTOOLS_MERGE {
        container = 'docker://dorinemerlat/varus:v1.1'
        cpus = 4
        memory = { getMemory(10.GB, task) }
        time = { getTime(6.h, task) }
        stageInMode = 'symlink'
        scratch = false
        tag = { "${meta.id}/${meta.rnaseq_run_signature ?: 'legacy'}" }
    }
    withName: AGAT_SPKEEPLONGESTISOFORM {
        ext.args = { params.program_args.agat_longest ?: '' }
        container = 'quay.io/biocontainers/agat:1.6.1--pl5321hdfd78af_1'
        ext.prefix = { "${meta.id}_${meta.annotation_method}_canonical" }
    }
    withName: AGAT_SPEXTRACTSEQUENCES {
        container = 'quay.io/biocontainers/agat:1.6.1--pl5321hdfd78af_1'
        ext.args = { '--protein ' + (params.program_args.agat_extract ?: '') }
        ext.prefix = { "${meta.id}_${meta.annotation_method}_proteins" }
    }
    withName: INTERPROSCAN {
        container = { params.interproscan_container ?: 'quay.io/biocontainers/interproscan:5.59_91.0--hec16e2b_1' }
        ext.args = { '-f TSV -dp -goterms -iprlookup -pa -t p' + ' ' + (params.program_args.interproscan ?: '') }
        ext.prefix = { "${meta.id}_${meta.annotation_method}_ips" }
    }
    withName: EGGNOGMAPPER {
        container = 'quay.io/biocontainers/eggnog-mapper:2.1.12--pyhdfd78af_1'
        cpus = 8
        memory = { getMemory(16.GB, task) }
        time = { getTime(20.h, task) }
        // Link the bank database rather than copying it to scratch.
        stageInMode = 'symlink'
        ext.args = { '--report_orthologs --scratch_dir /tmp --temp_dir /tmp' + ' ' + (params.program_args.eggnog ?: '') }
        ext.prefix = { "${meta.id}_${meta.annotation_method}_eggnog" }
        ext.dbmem = false
    }
}

process {
    withLabel: 'omark' {
        cpus = 8
        memory = { getMemory(32.GB, task) }
    }
    withLabel: 'infernal' {
        memory = { getMemory(16.GB, task) }
        time = { getTime(5.d, task) }
    }
}

// Standard nf-core tools with AnnoGlyph's scientific options and existing images.
process {
    withName: '(BARRNAP_EUK|BARRNAP_MITO)' {
        container = 'docker://dorinemerlat/exogap_tools:v1.5'
        cpus = 30
        ext.args = { '--quiet ' + (params.program_args.barrnap ?: '') }
        ext.prefix = { "${meta.id}_barrnap" }
    }
    withName: TRNASCANSE {
        container = 'quay.io/biocontainers/trnascan-se:2.0.12--pl5321h7b50bb2_2'
        cpus = 8
        scratch = false
        ext.args = { "-E --progress --struct ${meta.id}_trna.struct " + (params.program_args.trnascan ?: '') }
        ext.prefix = { "${meta.id}_trna" }
    }
    withName: INFERNAL {
        container = 'quay.io/biocontainers/infernal:1.1.5--pl5321h7b50bb2_4'
        cpus = 30
        memory = { getMemory(16.GB, task) }
        time = { getTime(5.d, task) }
        ext.args = { "-Z ${meta.assembly_size * 2 / 1000000.0} --cut_ga --rfam --nohmmonly --oskip " + (params.program_args.infernal ?: '') }
        ext.prefix = { "${meta.id}_infernal" }
    }
    withName: '(BUSCO_PROTEINS|BUSCO_PROTEINS_AFTER)' {
        container = 'docker://ezlabgva/busco:v6.0.0_cv1'
        cpus = 10
        memory = { getMemory(10.GB, task, force=true) }
        errorStrategy = { getErrorStrategy(task.exitStatus, true, task.workDir) }
        stageOutMode = 'copy'
        ext.args = { '--offline --force ' + (params.program_args.busco ?: '') }
        ext.prefix = { "${meta.id}_${meta.annotation_method}" }
    }
    withName: STAR_GENOMEGENERATE {
        tag = { meta.id }
        container = 'docker://dorinemerlat/varus:v1.1'
        cpus = 20
        memory = { getMemory(50.GB, task) }
        time = { getTime(5.d, task) }
        stageInMode = 'copy'
        ext.args = { "--genomeSAindexNbases ${Math.max(1, Math.min(14, (int)(Math.log(meta.assembly_size as double) / Math.log(2) / 2 - 1)))} " + (params.program_args.star_index ?: '') }
    }
    withName: '(STAR_SINGLE|STAR_PAIRED)' {
        container = 'docker://dorinemerlat/varus:v1.1'
        tag = { "${meta.genome_id}/${meta.run_id}/${meta.readset_signature}" }
        ext.args = { "--outSAMattrRGline - --outSAMstrandField intronMotif --outSAMtype BAM Unsorted --limitBAMsortRAM ${(long)(task.memory.toBytes() * 0.8d)} " + (params.program_args.star ?: '') }
        ext.prefix = { "${meta.id}_star" }
    }
    withName: SORT_RNASEQ_BAM {
        memory = { getMemory(((task.cpus * (params.rnaseq_sort_memory_per_thread_mb as int)) + 2048).MB, task) }
        time = { getTime(1.d, task) }
    }
    withName: '(SRATOOLS_PREFETCH|SRATOOLS_FASTERQDUMP|CUSTOM_SRATOOLSNCBISETTINGS)' {
        container = 'docker://dorinemerlat/phyloconstructor-rna:1.1.1'
    }
    withName: SRATOOLS_PREFETCH {
        ext.args = '--max-size 100G'
        memory = { getMemory(8.GB, task) }
        maxForks = 4
        scratch = false
        beforeScript = 'export TMPDIR="$PWD"; export TMP="$PWD"; export TEMP="$PWD"'
    }
    withName: SRATOOLS_FASTERQDUMP {
        ext.args = '--split-files'
        cpus = 10
        memory = { getMemory(10.GB, task) }
        maxForks = 4
        scratch = false
        beforeScript = 'export TMPDIR="$PWD"; export TMP="$PWD"; export TEMP="$PWD"'
    }
}
