// Increase memory after an out-of-memory failure.
// When force=true, increase memory after every retry.
def getMemory(baseMemory, task, force=false) {
    if (task.attempt > 1) {
        if (force || task.previousTrace.exit in [137, 140]) {
            return baseMemory * task.attempt
        }
    }

    return baseMemory
}

// Increase walltime linearly after a timeout.
def getTime(baseTime, task) {
    if (task.attempt > 1 && task.previousTrace.exit == 143) {
        return baseTime * task.attempt
    }

    return baseTime
}


// Retry only memory failures and timeouts.
// When force=true, retry regardless of the previous exit status.
def getErrorStrategy(exitStatus, force=false) {
    if (force || exitStatus in [137, 140, 143]) {
        return 'retry'
    }

    return 'finish'
}


// Define default process options for all modules here.
process {
    // General process options

    cpus = 1
    memory = { getMemory(2.GB, task) }
    time = { getTime(4.h, task) }

    maxRetries = 4
    errorStrategy = { getErrorStrategy(task.exitStatus) }

    // Only modules with specific resource requirements are defined here, others will use the default values above
    // Preprocessing module
    withName: 'AnnoGlyph:PREPROCESSING:SEQKIT_STATS' {
        container = 'quay.io/biocontainers/seqkit:2.8.2--h9ee0642_1'
        ext.args = { '--seq-type dna --all ' + (params.program_args.seqkit ?: '') }
    }

    withName: BUSCO_DOWNLOAD {
        container = 'docker://ezlabgva/busco:v6.0.0_cv1'
        memory = { getMemory(10.GB, task) }
    }

    withName: BUSCO_BUSCO {
        container = 'docker://ezlabgva/busco:v6.0.0_cv1'
        // Parent directories and nested files are both emitted by this module.
        // Copy them to storeDir so staging the parent cannot remove child outputs.
        stageOutMode = 'copy'
        cpus = 10
        memory = { getMemory(10.GB, task, force=true) }
        errorStrategy = { getErrorStrategy(task.exitStatus, force=true) }
        ext.args = { '--offline --force' + ' ' + (params.program_args.busco ?: '') }
        ext.prefix = { "${meta.id}_on_assembly" }
    }

    withName: GENERATE_TAXONOMY_METADATA {
        maxForks = 10
    }

    withName: REFORMAT_GENOME {
        memory = { getMemory(10.GB, task) }
    }


    withLabel: 'busco' {
        cpus = 10
        memory = { getMemory(10.GB, task, force=true) }
        errorStrategy = { getErrorStrategy(task.exitStatus, force=true) }
    }

    // Repetitive elements prediction module
    withName: REPEATMODELER_BUILDDATABASE {
        container = 'quay.io/biocontainers/repeatmodeler:2.0.5--pl5321hdfd78af_0'
        ext.args = '-engine ncbi'
    }

    withName: REPEATMODELER_REPEATMODELER {
        container = 'quay.io/biocontainers/repeatmodeler:2.0.5--pl5321hdfd78af_0'
        cpus = 30
        memory = { getMemory(100.GB, task) }
        time = { getTime(20.d, task) }
        ext.args = { '-engine ncbi -LTRStruct' + ' ' + (params.program_args.repeatmodeler ?: '') }
        ext.prefix = { "${meta.id}-families" }
    }

    withName: CDHIT_CDHITEST {
        container = 'quay.io/biocontainers/cd-hit:4.8.1--h5ca1c30_13'
        cpus = 10
        memory = { getMemory(50.GB, task) }
        time = { getTime(10.h, task) }
        ext.args = { '-c 0.8 -n 10 -l 80 -aS 0.8 -g 1 -sc 1 -sf 1 -d 0' + ' ' + (params.program_args.cdhit ?: '') }
        ext.memory_limit = 0
        ext.prefix = { "${meta.id}.nr" }
        ext.suffix = 'fa'
    }

    withName: REPEATMASKER_REPEATMASKER {
        container = 'quay.io/biocontainers/repeatmasker:4.2.1--pl5321hdfd78af_0'
        cpus = 30
        memory = { getMemory(50.GB, task) }
        time = { getTime(5.d, task) }
        ext.args = { '-e ncbi -a -gccalc -norna -excln -s -xsmall -gff' + ' ' + (params.program_args.repeatmasker ?: '') }
        ext.prefix = { "genome_${meta.id}.fa" }
    }


    withName: HMMSCAN_BUSCO_GENES {
        cpus = 5
        memory = { getMemory(10.GB, task) }
        time = { getTime(2.h, task) }
    }

    withName: HMMSCAN_RRNA {
        cpus = 5
        memory = { getMemory(10.GB, task) }
        time = { getTime(2.h, task) }
    }

    withName: MCHELPER {
        cpus = 20
        memory = { getMemory(50.GB, task) }
        time = { getTime(20.d, task) }
    }



    withName: SUMMARIZE_REPEATS_BY_LEVEL {
        memory = { getMemory(10.GB, task) }
    }

    // Protein-coding gene prediction module
    withName: GENERATE_RUNLIST {
        maxForks = 1
    }

    withName: DOWNLOAD_SRA {
        cpus = 10
        memory = { getMemory(10.GB, task) }
    }

    withName: STAR_SINGLE {
        cpus = 20
        memory = { getMemory(50.GB, task) }
        time = { getTime(5.d, task) }
        stageInMode = 'copy'
    }

    withName: STAR_PAIRED {
        cpus = 20
        memory = { getMemory(50.GB, task) }
        time = { getTime(5.d, task) }
        stageInMode = 'copy'
    }


    withName: VARUS {
        cpus = 20
        memory = { getMemory(64.GB, task) }
        time = { getTime(5.d, task) }
        stageInMode = 'copy'
    }

    withName: BRAKER2 {
        cpus = 20
        memory = { getMemory(64.GB, task) }
        time = { getTime(5.d, task) }
        stageInMode = 'copy'
        errorStrategy = { getErrorStrategy(task.exitStatus, force=true) }
    }

    withName: BRAKER3 {
        cpus = 20
        memory = { getMemory(64.GB, task) }
        time = { getTime(5.d, task) }
        stageInMode = 'copy'
        errorStrategy = { getErrorStrategy(task.exitStatus, force=true) }
    }

    withName: GALBA {
        cpus = 20
        memory = { getMemory(64.GB, task) }
        time = { getTime(5.d, task) }
        stageInMode = 'copy'
        errorStrategy = { getErrorStrategy(task.exitStatus, force=true) }
    }

    withName: BLASTP {
        cpus = 10
    }

    withName: INTERPROSCAN {
        cpus = 10
    }


    withName: INTERPROSCAN {
        memory = { getMemory(8.GB, task) }
    }

    // Optional QC modules retain their resources when the subworkflow is enabled.
    withLabel: 'omark_filter' {
        memory = { getMemory(10.GB, task) }
    }

    withName: TOXPROT_BLASTP {
        cpus = 5
        memory = { getMemory(5.GB, task) }
    }

    withName: SIGNALP {
        memory = { getMemory(10.GB, task) }
    }

    // Post-processing module
}

// nf-core replacements in the protein-coding gene subworkflows.
process {
    withName: SAMTOOLS_MERGE {
        container = 'docker://dorinemerlat/varus:v1.1'
        cpus = 4
        memory = { getMemory(10.GB, task) }
        time = { getTime(6.h, task) }
        stageInMode = 'copy'
    }
    withName: AGAT_SPKEEPLONGESTISOFORM {
        ext.args = { params.program_args.agat_longest ?: '' }
        container = 'quay.io/biocontainers/agat:1.6.1--pl5321hdfd78af_1'
        ext.prefix = { "${meta.id}_${meta.annotation_method}_canonical" }
    }
    withName: AGAT_SPEXTRACTSEQUENCES {
        container = 'quay.io/biocontainers/agat:1.6.1--pl5321hdfd78af_1'
        ext.args = { '--protein ' + (params.program_args.agat_extract ?: '') }
        ext.prefix = { "${meta.id}_${meta.annotation_method}_proteins" }
    }
    withName: INTERPROSCAN {
        container = 'quay.io/biocontainers/interproscan:5.59_91.0--hec16e2b_1'
        ext.args = { '-f TSV -dp -goterms -iprlookup -pa -t p' + ' ' + (params.program_args.interproscan ?: '') }
        ext.prefix = { "${meta.id}_${meta.annotation_method}_ips" }
    }
    withName: EGGNOGMAPPER {
        container = 'quay.io/biocontainers/eggnog-mapper:2.1.12--pyhdfd78af_1'
        cpus = 8
        memory = { getMemory(16.GB, task) }
        time = { getTime(20.h, task) }
        // Link the bank database rather than copying it to scratch.
        stageInMode = 'symlink'
        ext.args = { '--report_orthologs --scratch_dir /tmp --temp_dir /tmp' + ' ' + (params.program_args.eggnog ?: '') }
        ext.prefix = { "${meta.id}_${meta.annotation_method}_eggnog" }
        ext.dbmem = false
    }
}

process {
    withLabel: 'omark' {
        cpus = 8
        memory = { getMemory(32.GB, task) }
    }
    withLabel: 'infernal' {
        memory = { getMemory(16.GB, task) }
        time = { getTime(5.d, task) }
    }
}
