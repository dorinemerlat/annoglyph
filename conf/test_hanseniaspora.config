// Minimal integration test (legacy profile name retained as an alias).
params {
    run_group = "test_hanseniaspora_minimal"
    input = "${projectDir}/test/samplesheet_hanseniaspora.csv"
    outdir = "${projectDir}/test/test_hanseniaspora/minimal/results"
    cacheDir = "${projectDir}/test/test_hanseniaspora/minimal/cache"

    module_repeats = true
    module_genes = true
    module_ncgenes = true
    comparative_genomics = true
    busco_lineage = null
    reference_library = null
    group_consensus_sequences = true

    protein_set = "${projectDir}/test/test_hanseniaspora/protein_evidence_2000.fasta"
    protein_evidence_min_sequences = 2000
    protein_evidence_max_sequences = 2000

    rna_seq_aligner = 'star'
    sra_max_spots = 500000
    rnaseq_min_mapped_reads = 100000
    sra_run_limit = 3
    sra_run_max_bases = 1000000000
}
