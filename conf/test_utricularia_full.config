// Full evaluation: automatic protein evidence excluding the target genus, all eligible SRA reads.
params {
    run_group = "test_utricularia_full"
    input = "${projectDir}/test/samplesheet_utricularia.csv"
    outdir = "${projectDir}/test/test_utricularia/full/results"
    cacheDir = "${projectDir}/test/test_utricularia/full/cache"

    module_repeats = true
    module_genes = true
    module_ncgenes = true
    comparative_genomics = true
    busco_lineage = null
    reference_library = null
    group_consensus_sequences = true

    protein_set = null
    evaluation_mode = true
    protein_evidence_min_sequences = 100000
    protein_evidence_max_sequences = null

    rna_seq_aligner = 'star'
    sra_max_spots = null
    sra_run_limit = null
    sra_run_max_bases = null
}
