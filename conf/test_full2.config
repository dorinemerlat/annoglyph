/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXOGAP full test configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    input    = "${projectDir}/test/samplesheet_full2.csv"
    outdir   = "${projectDir}/test/test_full2/results"
    cacheDir = "${projectDir}/test/test_full2/cache"

    module_repeats       = true
    module_genes         = true
    module_ncgenes       = true
    comparative_genomics = true

    busco_lineage = null

    reference_library         = null
    group_consensus_sequences = true

    protein_set                    = null
    protein_evidence_min_sequences = 10000

    blast_db = null

    sra_run_limit     = 3
    sra_run_max_bases = 1000000000  // 1 Gbases
}