// Minimal integration test (legacy profile name retained as an alias).
params {
    input = "${projectDir}/test/samplesheet_utricularia.csv"
    outdir = "${projectDir}/test/test_utricularia/minimal/results"
    cacheDir = "${projectDir}/test/test_utricularia/minimal/cache"

    module_repeats = true
    module_genes = true
    module_ncgenes = true
    comparative_genomics = true
    busco_lineage = null
    reference_library = null
    group_consensus_sequences = true

    protein_set = "${projectDir}/test/test_utricularia/protein_evidence_2000.fasta"
    protein_evidence_min_sequences = 2000
    protein_evidence_max_sequences = 2000
    blast_db = null
    rna_seq_aligner = 'star'
    sra_run_limit = 3
    sra_run_max_bases = 1000000000
}
