// Load with -c conf/programs.example.config after your site config.
// Change these examples for the biological group and computational environment.
params {
    program_args = [
        star: '--outFilterMismatchNmax 8',
        blastp: '-seg yes'
    ]
    program_resources = [
        star: [cpus: 16, memory: '64 GB', time: '2d'],
        busco: [cpus: 8, memory: '16 GB', time: '12h'],
        infernal: [cpus: 16, memory: '32 GB', time: '2d']
    ]
    gene_min_length = 90
    translation_table = 1
    rfam_release = '15.0'

    // Define bank and program paths centrally in nextflow.config (params block).
    // These examples can override them for a particular run.
    // eggnog_db = '/path/to/versioned/eggnog/database'
    // blast_db = '/path/to/versioned/blast/database/prefix'
    // omamer_db = '/path/to/archived/LUCA.h5'
    // interproscan_db = '/path/to/versioned/interproscan/data'

    // Optional metadata and local NCBI validation. Replace all example IDs.
    // submission_metadata = '/path/to/submission_metadata.json'
    // submission_template = '/path/to/template.sbt'
    // table2asn_binary = '/path/to/table2asn'
    // table2asn_sha256 = '64-character-sha256-of-that-binary'
    validate_submission = false
    submission_fail_on_errors = true

    // Full bank hashes are expensive for large databases; input FASTAs are hashed.
    provenance_hash_databases = false
    // database_lock_file = '/path/to/previous/databases.lock.json'
    // uniprot_evidence_release = '2026_01'
}
