process {
    storeDir = {
        /*
        * NFCORE_AnnoGlyph:AnnoGlyph:SUBWORKFLOW:[SUBSUBWORKFLOW]:PROCESS
        * -> cache/subworkflow/[subsubworkflow]/process/[tag]
        */

        def task_name_components = task.process.tokenize(':').drop(1)
        if (params.evaluation_mode && !params.protein_set && task_name_components.any { it in ['GENES_ANNOTATION', 'POSTPROCESSING'] }) {
            task_name_components.add(0, 'genus_evaluation_v1')
        }
        // Historical predictions are explicit imports. Recompute current derived
        // gene analyses in their own namespace instead of accepting stale outputs.
        if (params.legacy_cache_manifest && task_name_components.any { it in ['GENES_ANNOTATION', 'REUSED_REPEATS_ANNOTATION'] }) {
            task_name_components.add(0, 'cache_reuse_v1')
        }
        if (task_name_components.last() in ['BARRNAP_EUK', 'BARRNAP_MITO', 'TRNASCANSE', 'INFERNAL', 'BUSCO_PROTEINS', 'BUSCO_PROTEINS_AFTER', 'STAR_GENOMEGENERATE', 'STAR_SINGLE', 'STAR_PAIRED', 'SRATOOLS_PREFETCH', 'SRATOOLS_FASTERQDUMP', 'CUSTOM_SRATOOLSNCBISETTINGS']) {
            task_name_components.add(0, 'nfcore_tools_v2')
        }
        def tag = task.tag ?: ''
        if (task_name_components.contains('POSTPROCESSING')) {
            def thresholdsJson = groovy.json.JsonOutput.toJson(new TreeMap(params.selection_thresholds))
            def selectionSignature = java.security.MessageDigest.getInstance('SHA-256').digest(thresholdsJson.getBytes('UTF-8')).encodeHex().toString().take(16)
            task_name_components.add(0, "results_layout_v2/selection_${selectionSignature}")
        }
        if (task_name_components.any { it in ['ANNOTATION_QC_AND_CONTAMINATION_FILTERING', 'ANNOTATION_COMPARISON_AND_SELECTION', 'NCGENES_ANNOTATION', 'POSTPROCESSING'] }) {
            task_name_components.add(0, 'annotation_export_v1')
        }

        (
            "${params.cacheDir}/" +
            task_name_components.join('/') +
            (tag ? "/${tag}" : '')
        )
            .replace(':', '/')
            .toLowerCase()
    }
}
