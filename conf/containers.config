
process {
    withLabel: 'agat' { // Used by the modules: genes_annotation/structural_annotation/agat_filter_gene_by_length.nf, genes_annotation/structural_annotation/extract_canonical_proteins.nf
        container = 'quay.io/biocontainers/agat:1.6.1--pl5321hdfd78af_1'
    }

    withLabel: 'blast' { // Used by the modules: genes_annotation/functional_annotation/blastp.nf
        container = 'docker://biocontainers/blast:2.17.0--h66d330f_0'
    }

    withLabel: 'braker' { // Used by the modules: genes_annotation/structural_annotation/braker2.nf, genes_annotation/structural_annotation/braker3.nf
        container = 'docker://teambraker/braker3:v3.0.7.6'
    }

    withLabel: 'busco' { // Used by the modules: preprocessing/download_busco_dataset.nf, preprocessing/select_busco_dataset.nf, shared_modules/busco.nf
        container = 'docker://ezlabgva/busco:v6.0.0_cv1'
    }

    withLabel: 'cdhit' { // Used by the modules: repeats_annotation/cd_hit_est.nf
        container = 'quay.io/biocontainers/cd-hit:4.8.1--h5ca1c30_13'
    }

    withLabel: 'EGGNOG_MAPPER' { // Used by the modules: genes_annotation/functional_annotation/eggnog_mapper.nf
        container = 'quay.io/biocontainers/eggnog-mapper:2.1.12--pyhdfd78af_1'
    }
    
    withLabel: 'exogap_tools' { 
        container = 'docker://dorinemerlat/exogap_tools:v1.5'
    }
    
    withLabel: 'exogap_python' { // Used by the modules: preprocessing/download_newick.nf, preprocessing/fetch_taxonomy_metadata.nf, repeats_annotation/clean_repeat_families.nf, repeats_annotation/postprocess_mchelper.nf, repeats_annotation/reformat_repeatlandscape.nf, repeats_annotation/repeatmasker_out_to_gff.nf, repeats_annotation/summarize_repeats_by_level.nf, genes_annotation/rnaseq_assembly/generate_runlist.nf, genes_annotation/functional_annotation/transfer_functional_annotations.nf, genes_annotation/structural_annotation/prepare_protein_evidence.nf
        container = 'docker://dorinemerlat/exogap_python:v1.5'
    }

    withLabel: 'exogap_agat' {
        container = 'docker://dorinemerlat/exogap_agat:latest'
    }

    withLabel: 'mchelper' { // Used by the modules: repeats_annotation/mchelper.nf, repeats_annotation/hmmscan_rrna.nf, hmmscan_busco_genes.nf
        container = 'docker://dorinemerlat/mchelper:v1.7.0'
    }

    withLabel: 'interproscan' { // Used by the modules: genes_annotation/functional_annotation/interproscan.nf
        container = 'quay.io/biocontainers/interproscan:5.59_91.0--hec16e2b_1'
    }

    withLabel: 'galba' { // Used by the modules: genes_annotation/structural_annotation/galba.nf
        container = 'docker://katharinahoff/galba-notebook:devel'
    }

    withLabel: 'trnascan' {
        container = 'quay.io/biocontainers/trnascan-se:2.0.12--pl5321h7b50bb2_2'
    }

    withLabel: 'omark' {
        container = 'quay.io/biocontainers/omark:0.3.1--pyh7e72e81_1'
    }

    withLabel: 'python_phylo' {
        container = 'docker://dorinemerlat/python-exogap:v1.02'
    }

    withLabel: 'r_base' {
        container = 'docker://dorinemerlat/exogap_r:v0.1'
    }

    withLabel: 'repeatmasker' { // Used by the modules: repeats_annotation/repeatlandscape.nf, repeats_annotation/repeatmasker.nf
        container = 'quay.io/biocontainers/repeatmasker:4.2.1--pl5321hdfd78af_0'
    }

    withLabel: 'repeatmodeler' { // Used by the modules: repeats_annotation/repeatmodeler.nf
        container = 'quay.io/biocontainers/repeatmodeler:2.0.5--pl5321hdfd78af_0'
    }

    withLabel: 'rnammer' {
        container = 'docker://tpaisie/rnammer:latest'
    }

    withLabel: 'infernal' {
        container = 'quay.io/biocontainers/infernal:1.1.5--pl5321h7b50bb2_4'
    }

    withLabel: 'signalp' { // Used by the modules: genes_annotation/complementary_protein_analyses/signalp.nf
        container = 'docker://interpro/signalp:6.0i'
    }

    withLabel: 'seqkit' { // Used by the modules: preprocessing/seqkit_stats.nf
        container = 'quay.io/biocontainers/seqkit:2.8.2--h9ee0642_1'
    }

    withLabel: 'rna' { // Used by the modules: genes_annotation/rnaseq_assembly/download_sra.nf
        container = 'docker://dorinemerlat/phyloconstructor-rna:1.1.1'
    }

    withLabel: 'trinity' {
        container = 'quay.io/biocontainers/trinity:2.13.2--h00214ad_1'
    }

    withLabel: 'varus' {
        container = 'docker://dorinemerlat/varus:v1.1'
    }
}
