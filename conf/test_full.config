/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXOGAP full test configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    input       = "${projectDir}/test/samplesheet_full.csv"
    outdir      = "${projectDir}/test/test_full/results"
    cacheDir    = "${projectDir}/test/test_full/cache"
    
    module_repeats       = true
    module_genes         = true
    module_ncgenes       = true
    comparative_genomics = true

    busco_lineage = null

    reference_library           = null
    group_consensus_sequences   = true

    protein_set = null
    blast_db    = null
}