// Keep completion tasks separate from both historical and current predictions.
process {
    storeDir = { "${params.cacheDir}/finalize_cache_save_v1/${task.process.replace(':', '/').toLowerCase()}/${task.tag ?: 'all'}" }
    withName: NCRNA_STATS { storeDir = null }
    withName: COMPARATIVE_REPORT { storeDir = null }
}
