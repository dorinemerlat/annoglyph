process {
    storeDir = {
        /*
        * NFCORE_EXOGAP:EXOGAP:SUBWORKFLOW:[SUBSUBWORKFLOW]:PROCESS
        * -> cache/subworkflow/[subsubworkflow]/process/[tag]
        */

        def task_name_components = task.process.tokenize(':').drop(1)
        def tag = task.tag ?: ''

        (
            "${params.cacheDir}/" +
            task_name_components.join('/') +
            (tag ? "/${tag}" : '')
        )
            .replace(':', '/')
            .toLowerCase()
    }
}