/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    AnnoGlyph Nextflow configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Input/output
    input            = null
    outdir           = 'results'
    cacheDir         = 'cache'
    publish_dir_mode = 'copy'

    // Annotation modules
    module_repeats       = true
    module_genes         = true
    module_ncgenes       = true
    comparative_genomics = true

    // Shared annotation options
    busco_lineage = null

    // Repeat annotation
    reference_library           = null
    repeat_classification_table = "${projectDir}/data/repeats_classification.csv"
    group_consensus_sequences   = true

    // Protein-coding gene annotation
    protein_set                    = null
    protein_evidence_min_sequences = 100000
    protein_evidence_max_sequences = null
    blast_db                       = '/shared/bank/uniprot_swissprot/uniprot_swissprot_2025_01/blast/uniprot_sprot'
    interproscan_db                 = null
    omark_contamination_threshold  = 0.1
    sra_run_limit                  = null
    sra_run_max_bases              = null
    rna_seq_aligner                = 'both'
    tool_only_protein_evidence     = 'both'

    // Non-coding RNA annotation and final export
    rfam_db = null
    rfam_release = '15.0'
    ncrna_stats_group_rank = 'family'
    ncrna_stats_min_group_size = 3
    omamer_db = null
    locus_tag_prefix = null
    translation_table = 1

    // Override individual selection thresholds; omitted keys retain historical defaults.
    selection_thresholds = [:]

    // Submission metadata are explicit; official validation is opt-in.
    submission_metadata = null
    submission_template = null
    validate_submission = false
    table2asn_binary = null
    table2asn_sha256 = null
    submission_fail_on_errors = true
    // Central paths for versioned program databases/images; edit here for your server.
    // An existing lock file can check their recorded identities.
    eggnog_db = '/shared/bank/emapperdb/5.0.2/'
    interproscan_container = '/shared/software/singularity/images/interproscan-5.59-91.0.sif'
    omamer_download_url = 'https://zenodo.org/records/10403053/files/LUCA-v2.0.0.h5?download=1'
    omamer_download_md5 = 'c7b5969ed5577750c83973cb46bb0f2d'
    database_lock_file = null
    provenance_hash_databases = false
    // Extra CLI arguments and optional CPU/memory/time overrides by program.
    uniprot_evidence_release = null
    gene_min_length = 90
    program_args = [:]
    program_resources = [:]

    // Optional functional analyses
    signalp       = false
    toxprot_blast = false
}

includeConfig "$projectDir/conf/modules.config"
includeConfig "$projectDir/conf/containers.config"
includeConfig "$projectDir/conf/annoglyph.config"
includeConfig "$projectDir/conf/programs.config"
includeConfig "$projectDir/conf/reports.config"

profiles {
    docker {
        docker.enabled       = true
        docker.userEmulation = true
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.pullTimeout = '4h'
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.pullTimeout = '4h'
    }

    test {
        includeConfig "$projectDir/conf/test_minimal.config"
    }

    test_full1 {
        includeConfig "$projectDir/conf/test_full1.config"
    }

    test_full2 {
        includeConfig "$projectDir/conf/test_full2.config"
    }

    test_hanseniaspora_minimal {
        includeConfig "$projectDir/conf/test_hanseniaspora.config"
    }

    test_hanseniaspora_full {
        includeConfig "$projectDir/conf/test_hanseniaspora_full.config"
    }

    test_hanseniaspora {
        includeConfig "$projectDir/conf/test_hanseniaspora.config"
    }

    test_pieris_minimal {
        includeConfig "$projectDir/conf/test_pieris.config"
    }

    test_pieris_full {
        includeConfig "$projectDir/conf/test_pieris_full.config"
    }

    test_pieris {
        includeConfig "$projectDir/conf/test_pieris.config"
    }

    test_utricularia_minimal {
        includeConfig "$projectDir/conf/test_utricularia.config"
    }

    test_utricularia_full {
        includeConfig "$projectDir/conf/test_utricularia_full.config"
    }

    test_utricularia {
        includeConfig "$projectDir/conf/test_utricularia.config"
    }
}

// Adapt to your computing environment.
process {
    resourceLimits = [
        cpus: 300,
        memory: 1500.GB,
        time: 30.d
    ]
}

plugins {
    id 'nf-schema@2.7.2'
}

validation {
    monochromeLogs = false
}

env {
    PYTHONNOUSERSITE         = 1
    R_PROFILE_USER           = '/.Rprofile'
    R_ENVIRON_USER           = '/.Renviron'
    JULIA_DEPOT_PATH         = '/usr/local/share/julia'
    NXF_SINGULARITY_CACHEDIR = "$projectDir/.singularity"
    NXF_APPTAINER_CACHEDIR   = "$projectDir/.apptainer"
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

manifest {
    name            = 'AnnoGlyph'
    author          = 'Dorine MERLAT'
    homePage        = 'https://github.com/dorinemerlat/annoglyph'
    description     = 'Genome annotation pipeline for non-model eukaryotic species'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.10.0'
    version         = '1.0'
}