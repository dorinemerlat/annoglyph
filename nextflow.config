/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXOGAP Nextflow configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Input/output
    input            = null
    outdir           = 'results'
    cacheDir         = 'cache'
    publish_dir_mode = 'copy'

    // Annotation modules
    module_repeats       = true
    module_genes         = true
    module_ncgenes       = true
    comparative_genomics = true

    // Shared annotation options
    busco_lineage = null

    // Repeat annotation
    reference_library           = null
    repeat_classification_table = "${projectDir}/data/repeats_classification.csv"
    group_consensus_sequences   = true

    // Protein-coding gene annotation
    protein_set                   = null
    blast_db                      = null
    omark_contamination_threshold = 0.1
    rna_seq_aligner               = 'both'
    tool_only_protein_evidence    = 'both'
}

includeConfig "$projectDir/conf/modules.config"
includeConfig "$projectDir/conf/containers.config"
includeConfig "$projectDir/conf/exogap.config"
includeConfig "$projectDir/conf/reports.config"

profiles {
    docker {
        docker.enabled       = true
        docker.userEmulation = true
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }

    test {
        includeConfig "$projectDir/conf/test_minimal.config"
    }

    test_full {
        includeConfig "$projectDir/conf/test_full.config"
    }
}

// Adapt to your computing environment.
process {
    resourceLimits = [
        cpus: 300,
        memory: 1500.GB,
        time: 30.d
    ]
}

plugins {
    id 'nf-schema@2.7.2'
}

validation {
    monochromeLogs = false
}

env {
    PYTHONNOUSERSITE         = 1
    R_PROFILE_USER           = '/.Rprofile'
    R_ENVIRON_USER           = '/.Renviron'
    JULIA_DEPOT_PATH         = '/usr/local/share/julia'
    NXF_SINGULARITY_CACHEDIR = "$projectDir/.singularity"
    NXF_APPTAINER_CACHEDIR   = "$projectDir/.apptainer"
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

manifest {
    name            = 'EXOGAP'
    author          = 'Dorine MERLAT'
    homePage        = 'https://github.com/dorinemerlat/exogap'
    description     = 'Genome annotation pipeline for non-model eukaryotic species'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.10.0'
    version         = '1.0'
}