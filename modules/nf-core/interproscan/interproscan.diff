--- /dev/null
+++ b/modules/nf-core/interproscan/resources/ps
@@ -0,0 +1,7 @@
+#!/bin/bash
+# InterProScan 5.59's process monitor requires procps syntax. Its image uses BusyBox.
+if [[ $# -eq 4 && $1 == '-o' && $2 == 'pid,vsize,rss,command' && $3 == '-p' ]]; then
+    /bin/ps -o pid,vsz,rss,args | awk -v target="$4" 'NR == 1 || $1 == target'
+else
+    exec /bin/ps "$@"
+fi
